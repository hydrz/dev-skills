{
  "name": "dev-skills",
  "version": "0.5.6",
  "private": true,
  "description": "面向中文开发者的软件工程 Agent Skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/hydrz/dev-skills"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "check": "npm run lint && npm test",
    "lint": "npm run lint:writing && npm run lint:metadata && npm run lint:repository && npm run lint:budget && npm run lint:format",
    "lint:writing": "node scripts/lint-writing.mjs",
    "lint:metadata": "node scripts/sync-metadata.mjs --check",
    "lint:repository": "node scripts/validate-repository.mjs",
    "lint:budget": "node scripts/check-skill-budget.mjs",
    "report:size": "node scripts/check-skill-budget.mjs --base HEAD",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "sync": "node scripts/sync-metadata.mjs",
    "validate": "node scripts/validate-cli.mjs",
    "validate:claude": "node scripts/validate-cli.mjs --tool=claude",
    "validate:agy": "node scripts/validate-cli.mjs --tool=agy",
    "validate:codex": "node scripts/validate-cli.mjs --tool=codex",
    "test": "node --test scripts/**/*.test.mjs",
    "test:codex": "node --test scripts/eval/codex.runner.test.mjs",
    "test:agy": "node --test scripts/eval/antigravity.runner.test.mjs",
    "eval": "node scripts/eval/claude.mjs",
    "eval:claude": "node scripts/eval/claude.mjs",
    "eval:claude:quick": "node scripts/eval/claude.mjs --quick",
    "eval:codex": "node scripts/eval/codex.run.mjs",
    "eval:codex:quick": "node scripts/eval/codex.run.mjs --quick",
    "eval:agy": "node scripts/eval/antigravity.run.mjs",
    "eval:agy:quick": "node scripts/eval/antigravity.run.mjs --quick",
    "changeset": "changeset",
    "version": "changeset version && npm run sync"
  },
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "skills",
    "engineering",
    "chinese",
    "tdd",
    "code-review",
    "grilling",
    "domain-modeling"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "prettier": "^3.9.6"
  }
}
